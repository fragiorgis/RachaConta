  "components": [
    {
      "name": "Ação principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Dividir e Editar conta compartilham o mesmo estilo. Prévia em px; altura no Android é mínima.",
      "html": "<button class=\"ds-primary\">Dividir</button>",
      "css": ".ds-primary{font-family:Nunito,sans-serif;width:100%;min-height:56px;padding:14px 24px;background:#FFE784;color:#3B2519;border:0;border-radius:32px;font-size:20px;font-weight:800;cursor:pointer}.ds-primary:hover,.ds-primary:active{background:#FFE784}.ds-primary:focus-visible,.ds-text:focus-visible,.ds-step:focus-visible,.ds-back:focus-visible{outline:2px solid #9D8C7B;outline-offset:3px}"
    },
    {
      "name": "Ação de texto",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Usar exemplo; ação secundária já presente no formulário.",
      "html": "<button class=\"ds-text\">Usar exemplo</button>",
      "css": ".ds-text{font-family:Nunito,sans-serif;width:100%;min-height:48px;background:transparent;color:#3B2519;border:0;font-size:16px;font-weight:600;cursor:pointer}.ds-text:hover,.ds-text:active{color:#3B2519}.ds-primary:focus-visible,.ds-text:focus-visible,.ds-step:focus-visible,.ds-back:focus-visible{outline:2px solid #9D8C7B;outline-offset:3px}"
    },
    {
      "name": "Valor da conta",
      "kind": "input",
      "refersTo": "input-amount",
      "description": "Label externo e prefixo monetário; a prévia usa conteúdo estático para representar o prefixo Material.",
      "html": "<label class=\"ds-label\" for=\"ds-amount\">Valor da conta</label><div class=\"ds-field\"><span>R$</span><input id=\"ds-amount\" class=\"ds-amount\" value=\"100,00\" inputmode=\"decimal\"></div>",
      "css": ".ds-label{font-family:Nunito,sans-serif;display:block;color:#3B2519;font-size:16px;font-weight:600;margin-bottom:8px}.ds-field{font-family:Nunito,sans-serif;display:flex;align-items:center;gap:4px;min-height:64px;padding:0 16px;border:1px solid #9D8C7B;border-radius:14px;background:#FFFEFA;color:#3B2519}.ds-amount{font-family:Nunito,sans-serif;min-width:0;width:100%;border:0;background:transparent;color:#3B2519;font-size:28px;font-weight:700;outline:0}.ds-field:hover{border-color:#9D8C7B}.ds-field:focus-within{outline:2px solid #9D8C7B;outline-offset:2px}"
    },
    {
      "name": "Nome do encontro",
      "kind": "input",
      "refersTo": "input-name",
      "description": "Campo opcional com label permanente.",
      "html": "<label class=\"ds-name-label\" for=\"ds-name\">Nome do encontro (opcional)</label><input id=\"ds-name\" class=\"ds-name\" value=\"Pizza de sexta\">",
      "css": ".ds-name-label{font-family:Nunito,sans-serif;display:block;color:#3B2519;font-size:16px;font-weight:600;margin-bottom:8px}.ds-name{font-family:Nunito,sans-serif;width:calc(100% - 34px);min-height:60px;padding:0 16px;border:1px solid #9D8C7B;border-radius:14px;background:#FFFEFA;color:#3B2519;font-size:20px;font-weight:600}.ds-name:hover{border-color:#9D8C7B}.ds-name:focus-visible{outline:2px solid #9D8C7B;outline-offset:2px}"
    },
    {
      "name": "Seletor de pessoas",
      "kind": "custom",
      "refersTo": "stepper-button",
      "description": "Botões circulares e contador central; prévia visual sem lógica de cálculo.",
      "html": "<div class=\"ds-stepper\"><button class=\"ds-step\" aria-label=\"Diminuir pessoas\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg></button><span class=\"ds-count\">3</span><button class=\"ds-step\" aria-label=\"Aumentar pessoas\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5v14\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg></button></div>",
      "css": ".ds-stepper{display:flex;align-items:center;justify-content:space-between;gap:12px}.ds-step{width:64px;height:64px;background:#FFE784;color:#3B2519;border:0;border-radius:32px;display:grid;place-items:center;cursor:pointer}.ds-count{font-family:Nunito,sans-serif;color:#3B2519;font-size:32px;font-weight:800}.ds-step:hover,.ds-step:active{background:#FFE784}.ds-primary:focus-visible,.ds-text:focus-visible,.ds-step:focus-visible,.ds-back:focus-visible{outline:2px solid #9D8C7B;outline-offset:3px}"
    },
    {
      "name": "Voltar",
      "kind": "nav",
      "description": "A navegação local é um único botão com vetor.",
      "html": "<button class=\"ds-back\" aria-label=\"Voltar\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 5-7 7 7 7M5 12h15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>",
      "css": ".ds-back{display:grid;place-items:center;width:48px;height:48px;padding:0;border:0;background:transparent;color:#3B2519;cursor:pointer}.ds-back:hover,.ds-back:active{color:#3B2519}.ds-primary:focus-visible,.ds-text:focus-visible,.ds-step:focus-visible,.ds-back:focus-visible{outline:2px solid #9D8C7B;outline-offset:3px}"
    },
    {
      "name": "Parcela pendente",
      "kind": "custom",
      "refersTo": "payment-row",
      "description": "Pessoa/estado à esquerda, valor e check à direita; representa a linha plana existente.",
      "html": "<div class=\"ds-row\"><div class=\"ds-person\"><strong>Pessoa 2</strong><span>Pendente</span></div><strong class=\"ds-share\">R$ 33,33</strong><label class=\"ds-check-target\"><input class=\"ds-check\" type=\"checkbox\" aria-label=\"Pessoa 2 paga\"></label></div>",
      "css": ".ds-row{font-family:Nunito,sans-serif;display:flex;align-items:center;min-height:88px;padding:16px 0;border-bottom:1px solid #E8E0D6;color:#3B2519}.ds-person{flex:1;margin-right:8px;display:flex;flex-direction:column;gap:4px}.ds-person strong,.ds-share{font-size:18px;font-weight:700}.ds-person span{font-size:14px;font-weight:500;color:#746052}.ds-share{margin-right:12px}.ds-check-target{width:48px;height:48px;display:grid;place-items:center}.ds-check{width:20px;height:20px;accent-color:#FFE784;cursor:pointer}.ds-check:hover{outline:1px solid #9D8C7B}.ds-check:focus-visible{outline:2px solid #9D8C7B;outline-offset:3px}"
    },
    {
      "name": "Confirmação paga",
      "kind": "custom",
      "refersTo": "paid-check",
