<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/person_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="88dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="vertical">
            <TextView android:id="@+id/person_name" style="@style/Text.RachaConta.Label" android:layout_width="match_parent" android:textSize="18sp" android:textFontWeight="700" tools:text="Pessoa 1" />
            <TextView android:id="@+id/payment_status" style="@style/Text.RachaConta.Secondary" android:layout_marginTop="4dp" tools:text="Pendente" />
        </LinearLayout>
        <TextView android:id="@+id/share_value" style="@style/Text.RachaConta.Label" android:textSize="18sp" android:textFontWeight="700" android:layout_marginEnd="12dp" tools:text="R$ 33,33" />
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/paid_check" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:minHeight="48dp" android:padding="0dp" android:gravity="center" app:centerIfNoTextEnabled="true" app:buttonTint="@color/payment_tint" app:buttonIconTint="#3B2519" app:useMaterialThemeColors="false" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:importantForAccessibility="no" />
</LinearLayout>
