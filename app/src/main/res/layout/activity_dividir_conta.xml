<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding" android:paddingTop="12dp" android:paddingBottom="16dp">
        <ImageView android:id="@+id/logo" android:layout_width="300dp" android:layout_height="120dp" android:layout_gravity="center_horizontal" android:background="@drawable/logo_surface" android:src="@drawable/rachaconta_logo" android:scaleType="fitCenter" android:contentDescription="@string/app_name" />
        <TextView style="@style/Text.RachaConta.Heading" android:layout_marginTop="16dp" android:text="@string/divide_title" android:accessibilityHeading="true" />
        <TextView style="@style/Text.RachaConta.Label" android:layout_marginTop="24dp" android:labelFor="@id/amount_input" android:text="@string/bill_label" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/amount_layout" style="@style/Widget.RachaConta.Input" android:layout_marginTop="8dp" app:prefixText="@string/currency_prefix" app:prefixTextColor="@color/brown">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/amount_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:textSize="28sp" android:textFontWeight="700" android:inputType="numberDecimal" android:imeOptions="actionNext" android:textColorHint="@color/secondary_text" android:hint="@string/amount_hint" android:maxLength="12" android:singleLine="true" tools:text="100,00" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/Text.RachaConta.Label" android:layout_marginTop="24dp" android:text="@string/people_label" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/less_button" android:layout_width="64dp" android:layout_height="64dp" android:contentDescription="@string/less_people" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:stateListAnimator="@null" app:cornerRadius="32dp" app:backgroundTint="@color/yellow" app:icon="@drawable/ic_minus" app:iconTint="#3B2519" app:iconSize="28dp" app:iconPadding="0dp" app:iconGravity="textStart" />
            <TextView android:id="@+id/people_count" style="@style/Text.RachaConta.Heading" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:textSize="32sp" tools:text="3" android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton android:id="@+id/more_button" android:layout_width="64dp" android:layout_height="64dp" android:contentDescription="@string/more_people" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:stateListAnimator="@null" app:cornerRadius="32dp" app:backgroundTint="@color/yellow" app:icon="@drawable/ic_plus" app:iconTint="#3B2519" app:iconSize="28dp" app:iconPadding="0dp" app:iconGravity="textStart" />
        </LinearLayout>
        <TextView style="@style/Text.RachaConta.Label" android:layout_marginTop="24dp" android:labelFor="@id/name_input" android:text="@string/meeting_label" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/name_layout" style="@style/Widget.RachaConta.Input" android:layout_marginTop="8dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/name_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:textSize="20sp" android:textFontWeight="600" android:inputType="textCapSentences" android:imeOptions="actionDone" android:singleLine="true" android:textColorHint="@color/secondary_text" android:hint="@string/meeting_hint" android:maxLength="80" tools:text="Pizza de sexta" />
        </com.google.android.material.textfield.TextInputLayout>
        <Space android:layout_width="match_parent" android:layout_height="0dp" android:minHeight="24dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/divide_button" style="@style/Widget.RachaConta.Action" android:text="@string/divide_action" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
