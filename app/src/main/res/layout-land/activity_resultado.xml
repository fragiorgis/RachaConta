<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
    <androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingVertical="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/back_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp" android:contentDescription="@string/back" app:icon="@drawable/ic_back" app:iconSize="28dp" app:iconTint="@color/brown" app:iconPadding="0dp" app:iconGravity="textStart" />
            <TextView android:id="@+id/meeting_title" style="@style/Text.RachaConta.Heading" android:layout_width="match_parent" android:layout_marginTop="12dp" android:accessibilityHeading="true" />
            <TextView style="@style/Text.RachaConta.Label" android:layout_marginTop="16dp" android:text="@string/total_label" />
            <TextView android:id="@+id/total_value" style="@style/Text.RachaConta.Heading" android:layout_width="match_parent" android:textSize="@dimen/amount_size" android:layout_marginTop="4dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:orientation="vertical" android:paddingTop="12dp">
        <TextView style="@style/Text.RachaConta.Label" android:layout_marginStart="24dp" android:textSize="22sp" android:textFontWeight="800" android:layout_marginBottom="8dp" android:text="@string/per_person" android:accessibilityHeading="true" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/people_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="24dp" android:clipToPadding="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingVertical="12dp" android:orientation="vertical">
            <TextView android:id="@+id/paid_count" style="@style/Text.RachaConta.Secondary" android:accessibilityLiveRegion="polite" android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/edit_button" style="@style/Widget.RachaConta.Action" android:text="@string/edit_action" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
