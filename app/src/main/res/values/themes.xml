<resources>
    <style name="Theme.RachaConta" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/cream</item>
        <item name="colorSurface">@color/cream</item>
        <item name="colorOnSurface">@color/brown</item>
        <item name="colorOnSurfaceVariant">@color/secondary_text</item>
        <item name="colorPrimary">@color/yellow</item>
        <item name="colorOnPrimary">#3B2519</item>
        <item name="colorSecondary">@color/yellow</item>
        <item name="colorOnSecondary">#3B2519</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:fontFamily">@font/nunito_variable</item>
        <item name="fontFamily">@font/nunito_variable</item>
        <item name="android:textColor">@color/brown</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Text.RachaConta" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/body_size</item>
        <item name="android:textColor">@color/brown</item>
        <item name="android:fontFamily">@font/nunito_variable</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.RachaConta.Heading">
        <item name="android:textSize">@dimen/heading_size</item>
        <item name="android:textFontWeight">800</item>
    </style>
    <style name="Text.RachaConta.Label">
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="Text.RachaConta.Secondary">
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>
    <style name="Widget.RachaConta.Action" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/action_height</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:textColor">#3B2519</item>
        <item name="backgroundTint">@color/yellow</item>
        <item name="cornerRadius">32dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.RachaConta.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/field_surface</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
</resources>
